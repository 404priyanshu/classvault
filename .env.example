NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Server-only: used by privileged note workers and roadmap generation.
# Never expose this value through a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=service_role_REPLACE_ME
# Shared secret for the schedulers calling /api/cron/purge-notes and
# /api/cron/extract-notes.
CRON_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional, and deliberately commented out: npm run check:env treats every
# uncommented key here as required.
# GEMINI_API_KEY enables AI roadmaps; unset keeps the non-AI generator.
# Only public notes are sent to it. Never add it to Vercel Preview.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# ROADMAP_DAILY_LIMIT=5
